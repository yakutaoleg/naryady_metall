  "excel_recognition_rules": {
    "_comment": "Правила определения специализации по содержимому Excel-файла. Проверяются по порядку.",
    "rules": [
      {
        "id": "cross_ref_file",
        "specialization": "СПРАВОЧНИК",
        "description": "Файл со всеми деталями + колонка Сборка + Длина — только для cross-reference",
        "conditions": [
          {
            "has_column_contains": "Сборка"
          },
          {
            "has_column_contains": "Длина"
          }
        ]
      },
      {
        "id": "sverlenie_by_filename",
        "specialization": "СВЕРЛЕНИЕ",
        "description": "Filename contains otverstitj - file with drilling data for СВЕРЛЕНИЕ sheet",
        "conditions": [
          {
            "filename_contains_any": [
              "отверст"
            ]
          }
        ]
      },
      {
        "id": "plasma_by_section",
        "specialization": "ПЛАЗМА",
        "description": "Колонка Сечение содержит 'Пластина'",
        "conditions": [
          {
            "column_contains": "Сечение",
            "value_contains": "Пластина"
          }
        ]
      },
      {
        "id": "plasma_by_name",
        "specialization": "ПЛАЗМА",
        "description": "Название файла содержит 'пластин'",
        "conditions": [
          {
            "filename_contains_any": [
              "пластин",
              "просечн"
            ]
          }
        ]
      },
      {
        "id": "pila_by_section",
        "specialization": "ПИЛА",
        "description": "Колонка Сечение содержит профили (L, Т, Ш, ПВ, Двутавр, Швеллер, Уголок, Труба, ШП)",
        "conditions": [
          {
            "column_contains": "Сечение",
            "value_regex": "^(L |Т |ШП |ПВ|Двутавр|Швеллер|Уголок|Труба|Tг)"
          }
        ]
      },
      {
        "id": "pila_by_filename",
        "specialization": "ПИЛА",
        "description": "Название файла содержит 'профил' или 'просечн'",
        "conditions": [
          {
            "filename_contains_any": [
              "профил"
            ]
          }
        ]
      },
      {
        "id": "sborka_by_surface",
        "specialization": [
          "СБОРКА",
          "СВАРКА",
          "ГРУНТОВКА",
          "ПОКРАСКА"
        ],
        "description": "Есть колонка 'Поверхность' (м²) и нет колонки 'Длина' — это сборочные марки",
        "conditions": [
          {
            "has_column_contains": "Поверхность"
          },
          {
            "not_has_column_contains": "Длина"
          }
        ]
      },
      {
        "id": "sborka_by_filename",
        "specialization": [
          "СБОРКА",
          "СВАРКА",
          "ГРУНТОВКА",
          "ПОКРАСКА"
        ],
        "description": "Название файла содержит 'отправочн' или 'сборочн'",
        "conditions": [
          {
            "filename_contains_any": [
              "отправочн",
              "сборочн"
            ]
          },
          {
            "not_has_column_contains": "Длина"
          }
        ]
      }
    ],
    "column_mapping": {
      "_comment": "Как колонки Excel маппятся в колонки Google Sheet",
      "Поз.": "ПОЗ. СОГЛАСНО ЧЕРТЕЖА",
      "Поз": "ПОЗ. СОГЛАСНО ЧЕРТЕЖА",
      "Марка": "ЭЛЕМЕНТ",
      "Сечение": "СЕЧЕНИЕ",
      "Кол-во": "КОЛ-ВО",
      "Количество": "КОЛ-ВО",
      "Масса элемента (кг)": "МАССА ЕД. (кг)",
      "Масса всего (кг)": null,
      "Поверхность элемента (м2)": "Поверхность\nЭлемент (м²)",
      "Поверхность всего (м2)": "Поверхность\nЭлемент (м²)",
      "Поверхность Элемент (м2)": "Поверхность\nЭлемент (м²)",
      "Поверхность Элемент (м2) Всего (м2)": "Поверхность\nЭлемент (м²)",
      "Масса 1 п/м (кг/м)": "МАССА ЕД. (кг)",
      "Масса Всего (кг)": null,
      "Длина (мм)": null,
      "Марка стали": null,
      "Всего (м2)": null,
      "_note": "null означает колонку которая есть в Excel но не нужна в Sheet",
      "F элемента (кг)": "МАССА ЕД. (кг)",
      "элемента (кг)": "МАССА ЕД. (кг)",
      "Сборка": "ЭЛЕМЕНТ",
      "Позиция": "ПОЗ. СОГЛАСНО ЧЕРТЕЖА",
      "Класс стали": null,
      "всего (кг)": null,
      "Кол-во отверстий, шт.": "КОЛ-ВО ОТВЕРСТИЙ",
      "Кол-во отверстий шт.": "КОЛ-ВО ОТВЕРСТИЙ",
      "Кол-во отверстий, шт": "КОЛ-ВО ОТВЕРСТИЙ",

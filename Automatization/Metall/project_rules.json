      "Кол-во отверстий": "КОЛ-ВО ОТВЕРСТИЙ",
      "Количество отверстий": "КОЛ-ВО ОТВЕРСТИЙ",
      "Количество отверстий, шт.": "КОЛ-ВО ОТВЕРСТИЙ",
      "Кол-во отверстий,  шт.": "КОЛ-ВО ОТВЕРСТИЙ"
    }
  },
